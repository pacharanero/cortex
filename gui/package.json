{
  "name": "cortex-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:fixture",
    "dev:fixture": "vite --mode fixture",
    "dev:tauri": "vite --mode tauri",
    "build": "npm run build:fixture",
    "build:fixture": "tsc --noEmit && vite build --mode fixture",
    "build:tauri": "tsc --noEmit && vite build --mode tauri",
    "check": "npm run build:fixture && npm run build:tauri && npm run test",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
