{
  "name": "cortex-gui",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:fixture",
    "dev:fixture": "vite --mode fixture",
    "dev:tauri": "vite --mode tauri",
    "build": "npm run build:fixture",
    "build:fixture": "tsc --noEmit && vite build --mode fixture",
    "build:tauri": "tsc --noEmit && vite build --mode tauri",
    "generate:ipc": "cargo run --manifest-path ../Cargo.toml -p cortex-gui --example generate-typescript",
    "check:ipc": "npm run generate:ipc && git diff --exit-code -- src/shared/ipc/generated",
    "check": "npm run check:ipc && npm run build:fixture && npm run build:tauri && npm run test",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@tauri-apps/api": "2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
