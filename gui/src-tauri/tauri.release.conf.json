{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "category": "Music",
    "copyright": "Copyright 2026 Dr Marcus Baw",
    "externalBin": [
      "../../target/tauri-sidecars/cortex"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../../LICENSE",
    "longDescription": "Unofficial desktop editor for Neural DSP Cortex hardware. Linux is hardware-verified; macOS and Windows packages are provisional tester previews.",
    "resources": {
      "../../LICENSES/AGPL-3.0-or-later.txt": "licenses/AGPL-3.0-or-later.txt",
      "../../LICENSES/Apache-2.0.txt": "licenses/Apache-2.0.txt",
      "../../LICENSES/CC-BY-SA-4.0.txt": "licenses/CC-BY-SA-4.0.txt",
      "../../LICENSES/MIT.txt": "licenses/MIT.txt",
      "../../NOTICE": "NOTICE",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "shortDescription": "Unofficial desktop editor for Neural DSP Cortex hardware",
    "linux": {
      "deb": {
        "depends": [
          "libudev1"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-neural-dsp-cortex.rules": "../../70-neural-dsp-cortex.rules"
        },
        "section": "sound"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
