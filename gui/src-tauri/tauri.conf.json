{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cortex",
  "version": "0.1.0",
  "identifier": "org.neuraldsp.cortex",
  "build": {
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build:tauri",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "cortex",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.svg"
    ]
  }
}
