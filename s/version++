#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Dr Marcus Baw
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Bump the workspace version, commit, and land the release commit on main.
#
# The landing IS the release: the auto-tag workflow creates the tag once the
# commit reaches main. There is deliberately no `s/release` - a second script
# that also tagged and pushed was a source of divergence between repos.
#
# THIS PUSHES. On an unprotected repo it pushes to main directly; where branch
# protection is detected it opens a release PR instead.
#
# Adapted from ~/code/house-style/examples/s/version++. Every Rust crate takes
# `version.workspace = true`; the GUI's npm and Tauri manifests are synchronized
# to that canonical workspace version in the same release commit.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Pinned deliberately, same reasoning as s/markdownlint's MARKDOWNLINT_VERSION:
# an unpinned changelog generator turns an upstream release into a surprise
# diff in a release commit.
CLIFF_VERSION="2.13.1"

bump="patch"
mode="auto"

usage() {
	cat <<'EOF'
Usage: s/version++ [patch|minor|major] [--direct|--pr]

Creates chore(release): vX.Y.Z and lands it on main. This pushes.
The auto-tag workflow creates the tag after the commit reaches main.

  patch     0.0.1 -> 0.0.2   (default)
  minor     0.0.1 -> 0.1.0
  major     0.0.1 -> 1.0.0

  --direct  push to main
  --pr      open a release PR
            (default: detect branch protection and choose)
EOF
}

while (($#)); do
	case "$1" in
	patch | minor | major) bump="$1" ;;
	--direct) mode="direct" ;;
	--pr) mode="pr" ;;
	-h | --help)
		usage
		exit 0
		;;
	*)
		echo "Unknown argument: $1" >&2
		usage >&2
		exit 2
		;;
	esac
	shift
done

# --- preflight ------------------------------------------------------------
# Prerequisites and the full ordinary gate are checked before the version
# moves. Generated release files receive their own checks below.

command -v cargo-set-version >/dev/null 2>&1 ||
	{ echo "cargo-set-version is missing. Install it: cargo install cargo-edit" >&2; exit 1; }
command -v npm >/dev/null 2>&1 ||
	{ echo "npm is missing; it is required to synchronize the GUI release version." >&2; exit 1; }
command -v node >/dev/null 2>&1 ||
	{ echo "node is missing; it is required to synchronize the Tauri release version." >&2; exit 1; }
if [[ -f cliff.toml ]]; then
	command -v git-cliff >/dev/null 2>&1 ||
		{ echo "git-cliff ${CLIFF_VERSION} is missing. Install it: cargo install git-cliff --version ${CLIFF_VERSION} --locked" >&2; exit 1; }
	installed_cliff="$(git-cliff --version | awk '{print $2}')"
	[[ "$installed_cliff" == "$CLIFF_VERSION" ]] ||
		{ echo "Expected git-cliff ${CLIFF_VERSION}, found ${installed_cliff}. Install it: cargo install git-cliff --version ${CLIFF_VERSION} --locked" >&2; exit 1; }
fi

if [[ "$(git branch --show-current)" != "main" ]]; then
	echo "Refusing to release: check out main first." >&2
	exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
	echo "Refusing to release: the working tree is dirty." >&2
	exit 1
fi

detect_landing_mode() {
	if [[ "$mode" != "auto" ]]; then
		echo "$mode"
		return
	fi
	command -v gh >/dev/null 2>&1 || { echo "direct"; return; }
	local repo
	repo="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)"
	[[ -n "$repo" ]] || { echo "direct"; return; }
	if gh api "repos/${repo}/branches/main/protection" >/dev/null 2>&1; then
		echo "pr"
	else
		echo "direct"
	fi
}

landing_mode="$(detect_landing_mode)"

# The full local gate, not a subset. A release that skips a check the ordinary
# workflow runs is how a repo ends up shipping something CI would have caught.
echo "version++: running the full gate ..."
s/test
s/lint

# --- bump -----------------------------------------------------------------

cargo set-version --bump "$bump"
# Refresh only the workspace package entries. `cargo generate-lockfile` also
# upgrades every semver-compatible dependency, which does not belong in a
# version-only release commit.
cargo check --workspace --offline

version="$(awk -F\" '/^version = / { print $2; exit }' Cargo.toml)"
[[ -n "$version" ]] ||
	{ echo "Could not read the version from Cargo.toml after the bump." >&2; exit 1; }

(
	cd gui
	npm version "$version" --no-git-tag-version >/dev/null
)
node -e '
  const fs = require("fs");
  const path = "gui/src-tauri/tauri.conf.json";
  const config = JSON.parse(fs.readFileSync(path, "utf8"));
  config.version = process.argv[1];
  fs.writeFileSync(path, `${JSON.stringify(config, null, 2)}\n`);
' "$version"

# Only when the repo has adopted git-cliff; skipped silently otherwise so this
# script works before that decision is made.
if [[ -f cliff.toml ]]; then
	git cliff --tag "v${version}" --output CHANGELOG.md
	node -e '
      const fs = require("fs");
      const path = "CHANGELOG.md";
      fs.writeFileSync(path, `${fs.readFileSync(path, "utf8").trimEnd()}\n`);
    '
fi

s/check-versions
git diff --check
[[ ! -f CHANGELOG.md ]] || s/markdownlint CHANGELOG.md

if [[ "$landing_mode" == "pr" ]]; then
	git switch -c "release/v${version}"
fi

git add Cargo.toml Cargo.lock gui/package.json gui/package-lock.json gui/src-tauri/tauri.conf.json
[[ -f CHANGELOG.md ]] && git add CHANGELOG.md
git commit -m "chore(release): v${version}"

case "$landing_mode" in
direct)
	git push origin main
	;;
pr)
	git push -u origin "release/v${version}"
	gh pr create --base main --head "release/v${version}" \
		--title "chore(release): v${version}" --body "Release v${version}."
	;;
*)
	echo "Unknown landing mode: ${landing_mode}" >&2
	exit 1
	;;
esac

echo "version++: v${version} landed via ${landing_mode}. The workflow tags it."
