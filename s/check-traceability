#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Dr Marcus Baw
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Resolve every `@see` traceability header in the owned Rust tree against its
# target document, so a moved or renumbered spec/roadmap item is caught here
# rather than left as a dead pointer for the next reader to trip over.
#
# Each `@see` line is `<path> [ID] [ID2] ...` or `<path> ID` (a lone,
# unbracketed node id) or just `<path>` with no id at all. This script does
# not require a file to carry an `@see` header at all - a header-less file is
# ENG-004.1's job, not this gate's - it only checks headers that exist:
#
#   - the target path must exist in the tree
#   - each node id must resolve inside that target, as one of:
#       a bold roadmap/completed item marker  **ID**
#       a bracketed design-doc heading        ## [ID] ...
#       an FR/NFR requirements-table row      | ID | ...
#   - each file with an `@see` header must name at least one living spec.md or
#     design.md target, as required by spec/001-overview/spec.md
#
# This deliberately does not check for a back-reference from the spec back to
# the source file: only 8 of 13 zone spec.md files currently name an "Owned
# source" line, so that check would be noisy against zones that simply
# haven't adopted the convention yet rather than catching a real defect.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

findings=0
checked=0

fail() {
	findings=$((findings + 1))
	echo "  $1" >&2
}

trim() {
	local value="$1"
	value="${value#"${value%%[![:space:]]*}"}"
	value="${value%"${value##*[![:space:]]}"}"
	printf '%s' "$value"
}

node_exists() {
	local target="$1"
	local id="$2"
	local line stripped heading rest cell

	while IFS= read -r line || [[ -n "$line" ]]; do
		stripped="$(trim "$line")"

		case "$stripped" in
			"- [ ] **${id}**:"* | "- [x] **${id}**:"* | "- [~] **${id}**:"*)
				return 0
				;;
		esac

		heading="${stripped%% *}"
		if [[ "$heading" == \#* && "$heading" != *[!#]* ]]; then
			rest="$(trim "${stripped#"$heading"}")"
			[[ "$rest" == "[$id]" || "$rest" == "[$id] "* ]] && return 0
		fi

		if [[ "$stripped" == \|* ]]; then
			cell="${stripped#|}"
			cell="$(trim "${cell%%|*}")"
			[[ "$cell" == "$id" ]] && return 0
		fi
	done < "$target"

	return 1
}

tracked_files="$(git ls-files -- '*.rs')" || {
	echo "ERROR: could not enumerate tracked Rust files." >&2
	exit 1
}

while IFS= read -r file; do
	[[ -n "$file" ]] || continue
	[[ -f "$file" ]] || continue
	has_header=false
	has_living_target=false
	lineno=0

	while IFS= read -r content || [[ -n "$content" ]]; do
		lineno=$((lineno + 1))
		[[ "$content" == *"@see"* ]] || continue
		has_header=true
		after="${content#*@see}"
		after="$(trim "$after")"
		if [[ -z "$after" ]]; then
			fail "$file:$lineno: @see is missing a target"
			continue
		fi

		read -r -a tokens <<< "$after"
		target="${tokens[0]}"

		checked=$((checked + 1))

		if [[ ! -r "$target" ]]; then
			fail "$file:$lineno: @see target '$target' does not exist"
			continue
		fi
		case "$target" in
			spec/*/spec.md | spec/*/design.md) has_living_target=true ;;
		esac

		ids=()
		if [[ "${#tokens[@]}" -eq 2 && "${tokens[1]}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
			ids+=("${tokens[1]}")
		elif [[ "${#tokens[@]}" -gt 1 ]]; then
			valid_ids=true
			for token in "${tokens[@]:1}"; do
				if [[ "$token" =~ ^\[([A-Za-z0-9][A-Za-z0-9._-]*)\]$ ]]; then
					ids+=("${BASH_REMATCH[1]}")
				else
					valid_ids=false
					break
				fi
			done
			if [[ "$valid_ids" == false ]]; then
				fail "$file:$lineno: malformed @see; use <path>, <path> ID, or <path> [ID] [ID2]"
				continue
			fi
		fi

		for id in "${ids[@]}"; do
			node_exists "$target" "$id" && continue
			fail "$file:$lineno: @see $target [$id] - node id not found in $target"
		done
	done < "$file"

	if [[ "$has_header" == true && "$has_living_target" == false ]]; then
		fail "$file: @see headers must include at least one spec/*/spec.md or spec/*/design.md target"
	fi
done <<< "$tracked_files"

if [[ "$findings" -gt 0 ]]; then
	{
		echo
		echo "ERROR: $findings broken traceability link(s) among $checked @see line(s)."
		echo "Fix the path or node id, or update the target document to carry it."
	} >&2
	exit 1
fi

echo "traceability ok: $checked @see line(s) resolved cleanly"
