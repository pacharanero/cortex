#
# Lint the workspace: format check, clippy with -D warnings, and REUSE licence
# header lint. Run before every commit; `s/test` also runs the first two.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

cargo fmt --all --check
cargo clippy --all-targets --all-features -- -D warnings
# The GUI and other mock-first consumers need the protocol/domain/session
# surface without linking hidapi. Keep that feature boundary real locally,
# not only in CI.
cargo clippy --all-targets --no-default-features -- -D warnings
(cd gui && npm run check)

# Markdown is a first-class output here (docs site, specs, protocol reference),
# so it gets the same gate as the code.
s/markdownlint

# Fail if a docs/ page is unreachable from mkdocs.yml's nav (Zensical builds
# an orphan cleanly, so nothing else catches this), or if a docs/ internal
# link or heading anchor is broken.
s/check-docs-nav
s/linkcheck
s/spellcheck

if command -v reuse >/dev/null 2>&1; then
    reuse lint
else
    echo "s/lint: 'reuse' not installed; skipping SPDX lint (pip install reuse)" >&2
fi

# Fail if real device data (serials, MACs, firmware checksums) has crept
# into the repo. Docs examples come from a physical unit, so this is easy to
# do by accident and hard to undo once published.
s/lint-no-device-data

# Fail if the workspace version and the GUI's synchronized manifests have
# drifted apart outside an `s/version++` run.
s/check-versions

# Fail if an `@see` traceability header points at a document or node id that
# no longer exists - the header rots silently otherwise.
s/check-traceability
