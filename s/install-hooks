#
# Install this repository's tracked Git hooks for this checkout.
#
# Hooks are opt-in per checkout and deliberately not installed by any other
# script: a clone should never silently gain a commit-time side effect. Run
# this once after cloning if you want the pre-commit lint gate.
#
#   s/install-hooks     point core.hooksPath at .githooks
#   s/install-hooks -u  stop using the tracked hooks
#
# This sets core.hooksPath rather than writing into .git/hooks, because Git
# does not track .git/hooks and a copied hook goes stale the moment the
# tracked one changes.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [[ "${1:-}" == "-u" || "${1:-}" == "--uninstall" ]]; then
	git config --unset core.hooksPath || true
	echo "Tracked Git hooks removed; core.hooksPath is unset."
	exit 0
fi

[[ -d .githooks ]] ||
	{ echo "No .githooks directory found in this repository." >&2; exit 1; }

git config core.hooksPath .githooks
echo "Git hooks installed: core.hooksPath=.githooks"
echo "The pre-commit hook runs s/lint. Use 'git commit --no-verify' to skip it."
