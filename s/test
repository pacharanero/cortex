#
# The full local gate: fmt + clippy + tests. Mirrors .github/workflows/ci.yml
# so a green run here means a green run there. Run during development and
# before every commit.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

cargo fmt --all --check
cargo clippy --all-targets --all-features -- -D warnings
cargo test --all
cargo test --no-default-features -p cortex-rs
(cd gui && npm run check)
