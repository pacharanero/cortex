#
# Run the Rust and frontend build/test gate. Use it with s/lint before every
# commit; CI additionally checks Windows host compilation and Tauri integration.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

cargo fmt --all --check
cargo clippy --all-targets --all-features -- -D warnings
cargo test --all
# Mirrors CI's leaf-engine job: the GUI and other mock-first consumers build
# cortex-rs without linking hidapi, so that path needs its own test run.
cargo test --all --no-default-features
(cd gui && npm run check)
tests/check-traceability.sh
tests/check-docs-nav.sh
tests/linkcheck.sh
tests/spellcheck.sh
tests/install-release.sh
