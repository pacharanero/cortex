#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Dr Marcus Baw
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Install `cortex` and `cortex-mcp` from this checkout onto your PATH.
#
# This repo is a Cargo WORKSPACE whose root manifest has no [package], so
# `cargo install --path .` does not work here - the binary lives in
# crates/cortex-cli. This script points cargo at the right crate so you do
# not have to remember that.
#
# Builds in release mode and installs into ~/.cargo/bin (or
# $CARGO_INSTALL_ROOT). --locked uses the committed Cargo.lock so the install
# is reproducible.
#
#   s/install                # install `cortex` and `cortex-mcp`
#   s/install --cli-only     # install only `cortex`
#   s/install --mcp          # compatibility alias; MCP is installed by default
#   s/install --force        # reinstall over an existing copy
#   s/install --debug        # faster build, slower runtime
#   s/install --root ~/.local
#
# Any other flags are passed through to `cargo install`.
#
# Linux note: the binaries install without it, but Cortex hardware needs a udev
# rule granting your user access. This script checks the canonical two-device
# rule and reports the one-off fix if it is absent or stale.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

UDEV_RULE=/etc/udev/rules.d/70-neural-dsp-cortex.rules
SOURCE_UDEV_RULE=70-neural-dsp-cortex.rules

install_mcp=true
cargo_args=()
for arg in "$@"; do
  case "$arg" in
    --mcp) install_mcp=true ;;
    --cli-only) install_mcp=false ;;
    -h|--help) sed -n '5,27p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) cargo_args+=("$arg") ;;
  esac
done

echo "Installing cortex from crates/cortex-cli ..." >&2
cargo install --locked --path crates/cortex-cli "${cargo_args[@]+"${cargo_args[@]}"}"

if [[ "$install_mcp" == true ]]; then
  echo "Installing cortex-mcp from crates/cortex-mcp ..." >&2
  cargo install --locked --path crates/cortex-mcp "${cargo_args[@]+"${cargo_args[@]}"}"
fi

# --- post-install guidance -------------------------------------------------
# Not a failure: you can legitimately install on a machine with no device
# attached, and cargo has already done its job by this point.

udev_rule_complete=false
if [[ -f "$UDEV_RULE" ]] && cmp -s "$SOURCE_UDEV_RULE" "$UDEV_RULE"; then
  udev_rule_complete=true
fi

if [[ "$(uname -s)" == "Linux" && "$udev_rule_complete" != true ]]; then
  cat >&2 <<EOF

Heads up: $UDEV_RULE is missing or does not contain both Cortex products.

Without it /dev/hidraw* is root-only, so cortex will not be able to open the
device. To fix (one-off):

  sudo install -m 0644 $SOURCE_UDEV_RULE $UDEV_RULE
  sudo udevadm control --reload-rules
  sudo udevadm trigger --action=add --subsystem-match=hidraw

Then replug the unit. TAG+="uaccess" grants access to the logged-in user via
systemd-logind, which is preferable to adding yourself to a group. The rule
recognizes both devices; installed commands remain Quad-only while Nano
application-protocol integration is in development.
EOF
fi

cat >&2 <<'EOF'

Installed. Try:

  cortex device version            # confirm the device answers
  cortex catalog --search marshall # explore the model catalog
  cortex --help
EOF

if [[ "$install_mcp" == true ]]; then
  mcp_path="$(command -v cortex-mcp || true)"
  if [[ -n "$mcp_path" ]]; then
    cat >&2 <<EOF
Agent setup:

  cortex session start
  claude mcp add --transport stdio --scope user cortex -- "$mcp_path"
EOF
  else
    cat >&2 <<'EOF'
Agent setup: add the absolute path to the installed cortex-mcp binary to your
harness after adding its bin directory to PATH. See docs/agent-setup.md.
EOF
  fi
fi

cat >&2 <<'EOF'
Shell completions:

  cortex completions install
EOF
