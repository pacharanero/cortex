#
# Pre-commit hook: run the repository's lint gate.
#
# Installed by `s/install-hooks`, which is opt-in per checkout. Takes a few
# seconds with a warm cargo cache and considerably longer on a cold one.
#
# `git commit --no-verify` skips it when you genuinely need to commit
# work in progress.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

exec s/lint
